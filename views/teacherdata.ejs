<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <link rel="stylesheet" href="/css/navbar.css">
       <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>
<body>

        <%- include("partials/navbar") %>

    <div class="card offset-3 " style="width: 50rem; margin-top: 100px; ">

  <div class="card-body"><div style="display: flex; justify-content: space-between;">
    <h5 class="card-title"><%= teacher.name %></h5>
<a href="/teacher/edit/<%= teacher.id %>" ><i class="fa-solid fa-pencil"></i></a>
</div>
  <ul class="list-group list-group-flush">
      <li class="list-group-item"> Subject - <%=teacher.subject %></li>
    <li class="list-group-item"> Salary - <%= teacher.salary %></li>
    <li class="list-group-item">Mob. no - <%= teacher.m_number %></li>
    <li class="list-group-item">Joining date - <%=new Date(teacher.date_joining).toLocaleDateString("en-IN") %></li>
        <li class="list-group-item"> Sex - <%=teacher.gender  %></li>
  </ul>
</div>
</div>

   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</body>
</html>