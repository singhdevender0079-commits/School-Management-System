<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">
    <link href="/css/ssadd.css" rel="stylesheet">
</head>
<body>
 
    <div class="main">
        <form action="/students/add/submit" method="post">
            <span>
        <label for="sname">Student's name</label>
<input type="text" name="sname" placeholder="Name"  id="text" >
</span>
<span><label for="father_name">Father's name</label>
<input type="text" name="father_name" id="text">
</span>
<span>
<label for="class_name">Class</label>
<select name="class_name" required id="select">
    <option value="1">5A</option>
    <option value="2">5B</option>
    <option value="3">6A</option>
    <option value="4">6B</option>
    <option value="5">7A</option>
    <option value="6">7B</option>
    <option value="7">8A</option>
    <option value="8">8B</option>
    <option value="9">9A</option>
    <option value="10">9B</option>
    <option value="11">10A</option>
    <option value="12">10B</option>
</select>
</span>
<br>
<span>
<label for="gender">Gender</label>
<select name="gender" id="select">
    <option value="Male">Male</option>
    <option value="Female">Female</option>
</select>
</span>
<br>
<span>
<label for="rool_no "> Roll no.</label>
<input type="text" name="rool_no" id="text" placeholder="Roll-No">

</span>
<span>
<label for="registration_date">Registration date</label>
<input type="date" name="registration_date" id="date" placeholder="Registration-date">
</span>
<span>
<label for="DOB"> Date of Birth</label>
<input type="date" name="DOB" id="date">
</span>
<br>

<span>
<label for="medium">medium</label>
<select name="medium" id="">
    <option value="Hindi">Hindi</option>
    <option value="English">English</option>
</select>
</span>
<button>Submit</button>
        </form>
    </div>
  
</body>
</html>t